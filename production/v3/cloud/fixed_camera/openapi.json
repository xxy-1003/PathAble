  "components": {
    "schemas": {
      "CanonicalReportInput": {
        "properties": {
          "schema_id": {
            "type": "string",
            "const": "pathable.human-review.report.v1",
            "title": "Schema Id"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "client_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Client Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "edge_key": {
            "type": "string",
            "const": "B-C",
            "title": "Edge Key"
          },
          "junction": {
            "type": "string",
            "const": "B",
            "title": "Junction"
          },
          "destination": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Destination"
          },
          "detection_evidence": {
            "$ref": "#/components/schemas/DetectionEvidence"
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "distance_m": {
            "type": "null",
            "title": "Distance M"
          },
          "clearance_m": {
            "type": "null",
            "title": "Clearance M"
          },
          "measurement_source": {
            "type": "null",
            "title": "Measurement Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_id",
          "event_id",
          "client_id",
          "timestamp",
          "edge_key",
          "junction",
          "destination",
          "detection_evidence",
          "image"
        ],
        "title": "CanonicalReportInput"
      },
      "CanonicalReportRecord": {
        "properties": {
          "schema_id": {
            "type": "string",
            "title": "Schema Id"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "edge_key": {
            "type": "string",
            "title": "Edge Key"
          },
          "junction": {
            "type": "string",
            "title": "Junction"
          },
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "detection_evidence": {
            "$ref": "#/components/schemas/DetectionEvidence"
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "distance_m": {
            "type": "null",
            "title": "Distance M"
          },
          "clearance_m": {
            "type": "null",
            "title": "Clearance M"
          },
          "measurement_source": {
            "type": "null",
            "title": "Measurement Source"
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ],
            "title": "Status"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "expected_map_version": {
            "type": "integer",
            "title": "Expected Map Version"
          },
          "review": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewRecord"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "schema_id",
          "event_id",
          "client_id",
          "timestamp",
          "edge_key",
          "junction",
          "destination",
          "detection_evidence",
          "image",
          "distance_m",
          "clearance_m",
          "measurement_source",
          "ticket_id",
          "status",
          "received_at",
          "expected_map_version",
          "review"
        ],
        "title": "CanonicalReportRecord",
        "description": "Response shape for v1.1 canonical flow (tickets and canonical reports)."
      },
      "DetectionEvidence": {
        "properties": {
          "obstacle_class": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Obstacle Class"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "overlap_count": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Overlap Count"
          },
          "frame_count": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Frame Count"
          },
          "evidence_status": {
            "type": "string",
            "const": "client_reported",
            "title": "Evidence Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "obstacle_class",
          "confidence",
          "overlap_count",
          "frame_count",
          "evidence_status"
        ],
        "title": "DetectionEvidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "healthy",
            "title": "Status"
          },
          "storage": {
            "type": "string",
            "title": "Storage"
          },
          "map_version": {
            "type": "integer",
            "title": "Map Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "storage",
          "map_version"
        ],
        "title": "Health"
      },
      "ImageRef": {
        "properties": {
          "photo_id": {
            "type": "string",
            "format": "uuid",
            "title": "Photo Id"
          },
          "sha256": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "photo_id",
          "sha256"
        ],
        "title": "ImageRef"
      },
      "MapEdge": {
        "properties": {
          "from": {
            "type": "string",
            "title": "From"
          },
          "to": {
            "type": "string",
            "title": "To"
          },
          "distance": {
            "type": "null",
            "title": "Distance"
          },
          "distance_source": {
            "type": "string",
            "const": "unmeasured",
            "title": "Distance Source"
          },
          "route_weight": {
            "type": "integer",
            "title": "Route Weight"
          },
          "blocked": {
            "type": "boolean",
            "title": "Blocked"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "from",
          "to",
          "distance",
          "distance_source",
          "route_weight",
          "blocked"
        ],
        "title": "MapEdge"
      },
      "MapVersion": {
        "properties": {
          "map_id": {
            "type": "string",
            "const": "prototype",
            "title": "Map Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "map_id",
          "version"
        ],
        "title": "MapVersion"
      },
      "PhotoCreated": {
        "properties": {
          "photo_id": {
            "type": "string",
            "format": "uuid",
            "title": "Photo Id"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "photo_id",
          "sha256"
        ],
        "title": "PhotoCreated"
      },
      "PhotoLink": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "expires_in"
        ],
        "title": "PhotoLink"
      },
      "PhotoUpload": {
        "properties": {
